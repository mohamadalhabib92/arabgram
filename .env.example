# ArabGram — le cœur (11 unités, tashkīl, révisions, course « سباق المرشد »)
# n’a besoin d’aucune variable : tout fonctionne hors ligne.
#
# EXPO_PUBLIC_EXAMPLE_ENV_VAR : supprimée. Ne pas la réintroduire.
#
# Serveur uniquement — jamais en EXPO_PUBLIC_, jamais dans le client :
# OPENAI_API_KEY=YOUR_OPENAI_API_KEY
# PORT=YOUR_PORT
#
# Journal de crash. Désactivé tant que la valeur commence par YOUR_.
EXPO_PUBLIC_SENTRY_DSN=YOUR_SENTRY_DSN
#
# Phase 2 (éteinte). Placeholders uniquement, aucune vraie URL ni clé.
EXPO_PUBLIC_TUTOR_API_URL=YOUR_TUTOR_API_URL
EXPO_PUBLIC_SUPABASE_URL=YOUR_SUPABASE_URL
EXPO_PUBLIC_SUPABASE_ANON_KEY=YOUR_SUPABASE_ANON_KEY
#
# Flags lus au build via app.config.js (pas des secrets). false = phase 1.
FEATURE_TUTOR=false
FEATURE_ACCOUNT=false
